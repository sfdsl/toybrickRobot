# ============================================================
# 备份用 .gitignore（2026-09-21）
# 原则：只备份"自己写的/自己产出的 + 无法重建的"，构建产物与上游 clone 排除
# ============================================================

# ---- ROS 2 构建产物（可重建，且体积大）----
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# ---- 上游代码 clone（119M；我们对 slam_toolbox 的改动已导出到 ros2_ws/patches/）----
ros2_ws/src/slam_toolbox/

# ---- 嵌套上游仓库的元数据（本地保留为 .git-upstream，不上传）----
sd_power/.git-upstream/

# ---- 地图存档：不入 git（二进制，每套约 16M，攒几套就撑大仓库）----
# 地图请单独备份：拷到电脑/移动硬盘，或打包传网盘（详见 02_doc/09_使用说明.md §5）
04_map/

# ---- 运行时日志与录制数据 ----
logs/
*.log
*.bag
*.mcap
*.db3

# ---- Python / 编译中间产物 ----
__pycache__/
*.pyc
*.pyo
*.o
*.ko
*.mod
*.mod.c
*.cmd
*.symvers
*.order
*.tmp
*.swp
*~

# ---- 相机/可视化临时截图 ----
01_Project/**/view.jpg
01_Project/**/*.png
